#!/usr/bin/env bash
# DEPRECATED (2026-09-01).
#
# The journal no longer deploys skills. Shared skills (close, next, park, renew)
# come from incitaciones (npm) — managed by its installer into ~/.agents/skills/
# and declared as a pi project dependency in .pi/settings.json.
#
# Journal-specific skills (archive, capture, jlog, migrate, morning, standup,
# weekly, wrap-up) are symlinked from resources/skills/ into ~/.agents/skills/
# and are candidates for upstreaming into incitaciones.
#
# See resources/skills/README.md
echo "deprecated: journal skills are managed by incitaciones — run: pi install npm:incitaciones" >&2
exit 1
