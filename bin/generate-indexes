#!/usr/bin/env bash
# Look up a one-line description for `slug` in a directory's hand-written _index.md
# (_index.md format: - [slug](slug.md) — description)
describe_entry() {
  local dir="$1" display="$2"
  local idx="$dir/_index.md"
  if [ -f "$idx" ]; then
    awk -v slug="$display" -F' — ' '
      $1 ~ "^- \\[" slug "\\]" { for (i=2; i<=NF; i++) printf "%s%s", (i>2?" — ":""), $i; print ""; exit }
    ' "$idx"
  fi
}

# Generate index.md for every directory for browseable listings.
set -euo pipefail

ROOT="${1:-.}"

# Directories to index (PARA + log tree)
find "$ROOT/projects" "$ROOT/areas" "$ROOT/resources" "$ROOT/archive" \
  -type d 2>/dev/null | while read -r dir; do

  index="$dir/index.md"

  # Skip if a hand-written index already exists
  [ -f "$index" ] && continue

  # Relative path from root for the title
  rel="${dir#$ROOT/}"
  title="${rel:-journal}"

  {
    echo "# $title"
    echo ""

    # Parent link
    if [ "$rel" != "." ] && [ -n "$rel" ]; then
      echo "[..](../)"
      echo ""
    fi

    # List subdirectories first
    for entry in "$dir"/*/; do
      [ -d "$entry" ] || continue
      name="$(basename "$entry")"
      [[ "$name" == _* ]] && continue
      echo "- [$name/]($name/)"
    done

    # Then list files (link to .html since pandoc outputs html)
    for entry in "$dir"/*; do
      [ -f "$entry" ] || continue
      name="$(basename "$entry")"
      [[ "$name" == index.md ]] && continue
      [[ "$name" == _* ]] && continue
      [[ "$name" == .* ]] && continue

      # Strip extension for display, link to .html
      display="${name%.md}"
      link="${display}.html"
      desc="$(describe_entry "$dir" "$display")"
      if [ -n "$desc" ]; then
        echo "- [$display]($link) — $desc"
      else
        echo "- [$display]($link)"
      fi
    done
  } > "$index"
done

# Generate root index.md: nav block + README content
{
  cat << 'NAV'
[inbox](inbox.html) | [log](areas/log/) | [projects](projects/) | [areas](areas/) | [resources](resources/) | [archive](archive/) | [search](search.html)

---

NAV
  if [ -f "$ROOT/README.md" ]; then
    cat "$ROOT/README.md"
  else
    echo "# journal"
  fi
} > "$ROOT/index.md"

echo "Generated index pages"
